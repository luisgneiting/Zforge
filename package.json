{
  "name": "forge",
  "version": "22.51.0",
  "description": "Forge - Tiling Extension for GNOME",
  "main": "extension.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "prettier --list-different \"./**/*.{js,jsx,ts,tsx,json}\"",
    "lint:e2e": "eslint tests/e2e/framework",
    "lint:src": "eslint lib extension.js prefs.js",
    "pretypecheck": "make metadata",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "husky install",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,json}\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcrussell/forge.git"
  },
  "keywords": [
    "gnome",
    "forge",
    "tiling",
    "javascript",
    "gnome-shell"
  ],
  "author": "Jose Maranan",
  "contributors": [
    "Benny Powers <web@bennypowers.com>"
  ],
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/jcrussell/forge/issues"
  },
  "homepage": "https://github.com/jcrussell/forge#readme",
  "devDependencies": {
    "@girs/adw-1": "^5.5.0",
    "@girs/clutter-13": "^13.0.0-4.0.4",
    "@girs/gdk-4.0": "^5.5.0",
    "@girs/gio-2.0": "^5.5.0",
    "@girs/gjs": "^5.5.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/gobject-2.0": "^5.5.0",
    "@girs/gtk-4.0": "^5.5.0",
    "@girs/meta-13": "^13.0.0-4.0.4",
    "@girs/st-13": "^13.0.0-4.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,jsx}": "vitest related --run",
    "lib/**/*.js": "eslint",
    "{extension,prefs}.js": "eslint",
    "tests/e2e/framework/*.js": "eslint",
    "tests/e2e/**/*.py": [
      "ruff format",
      "ruff check --fix"
    ]
  }
}
